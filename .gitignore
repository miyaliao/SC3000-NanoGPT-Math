.venv/

# Python environment
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Model checkpoints
sft/gpt.pt
dpo/dpo.pt
dpo/dpo_epoch*.pt

# Slurm logs
*.out
*.err

# Disposable DPO smoke artifacts
dpo/smoke_outputs/

# Keep each experimental checkpoint out of Git
dpo/experiments/**/dpo.pt
# Round 1C checkpoint
dpo/experiments/round1c_incorrect/dpo.pt

# Round4 generated 100k preference datasets (generated locally and submitted separately)
/dpo/data/round4_matched_*/
# Avoid accidentally committing large per-epoch experiment checkpoints
/dpo/experiments/**/dpo_epoch*.pt

# Round5 generated 100k matched explanation datasets
/dpo/data/round5_decomposition/

# Round6 generated 4 x 100k matched preference data files
/dpo/data/round6_from_sft/

# Round6 20 epoch checkpoints, optimizer snapshots and evaluations
/dpo/experiments/round6_from_sft/

# Same-question prior-year public blind benchmark inference outputs
/dpo/experiments/prior_year_blind_*/

# Round7 generated TRAIN-only matched preference data and GPU outputs
/dpo/data/round7_targeted_*/
/dpo/experiments/round7_*/

# Round8 train-only self-mined real wrong completions, numerical variants and new checkpoints
/dpo/experiments/round8_*/
/dpo/data/round8_hardneg_full/

# Teacher-style 400 benchmark frozen questions+manifest ARE tracked;
# only inference outputs are ignored.
/dpo/experiments/teacher_style_400_v1_eval/

# Teacher-style 680: Core400 and Extension280 frozen files are tracked;
# only model predictions/summaries are ignored.
/dpo/experiments/teacher_style_680_v1_eval/
